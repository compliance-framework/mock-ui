{
  "name": "mock-ui",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest --run",
    "sync:mock-api-version": "scripts/sync-mock-api-version.sh"
  },
  "engines": {
    "npm": "^10.1",
    "node": "^20"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "always"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^20.19.43",
    "eslint": "^10.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.1",
    "vite": "^6.4.4",
    "vitest": "^4.1.11"
  }
}
